k            = 3,           # preview 3 cluster (sementara)
cex          = 0.5,
color_labels_by_k = TRUE,
rect         = TRUE,
rect_fill    = TRUE,
main         = "Dendrogram Hierarchical Clustering ISPU DKI Jakarta\n(Ward.D2 Linkage)",
xlab         = "Observasi",
ylab         = "Jarak (Height)",
sub          = "") +
theme(plot.title = element_text(hjust = 0.5, size = 13, face = "bold"))
# Simpan plot
ggsave("plot_1_dendrogram.png", width = 12, height = 6, dpi = 150)
cat("\n[✓] Dendrogram disimpan: plot_1_dendrogram.png\n")
# ── 8. Tentukan Jumlah Cluster Optimal (Silhouette Method) ────
# Silhouette mengukur seberapa baik observasi cocok di clusternya sendiri
# vs cluster tetangga — nilai mendekati +1 = sangat baik
sil_scores <- map_dbl(2:8, function(k) {
cut_k     <- cutree(hc, k = k)
sil       <- silhouette(cut_k, dist_mat)
mean(sil[, "sil_width"])
})
sil_df <- tibble(k = 2:8, silhouette = sil_scores)
cat("\nSkor Silhouette per jumlah cluster:\n")
print(sil_df)
# Plot Silhouette
ggplot(sil_df, aes(x = k, y = silhouette)) +
geom_line(color = "#2196F3", linewidth = 1.2) +
geom_point(size = 4, color = "#0D47A1") +
geom_vline(xintercept = sil_df$k[which.max(sil_df$silhouette)],
linetype = "dashed", color = "red", linewidth = 0.9) +
scale_x_continuous(breaks = 2:8) +
labs(title    = "Silhouette Method — Jumlah Cluster Optimal",
subtitle = "Garis merah = jumlah cluster terbaik",
x        = "Jumlah Cluster (k)",
y        = "Rata-rata Skor Silhouette") +
theme_minimal(base_size = 13) +
theme(plot.title    = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5, color = "gray50"))
ggsave("plot_2_silhouette.png", width = 8, height = 5, dpi = 150)
cat("[✓] Plot Silhouette disimpan: plot_2_silhouette.png\n")
# ── 9. Potong Dendrogram berdasarkan k optimal ────────────────
k_optimal <- sil_df$k[which.max(sil_df$silhouette)]
cat("\n[✓] Jumlah cluster optimal:", k_optimal, "\n")
cluster_label <- cutree(hc, k = k_optimal)
# Tambahkan hasil cluster ke dataset bersih
df_result <- df_clean %>%
mutate(cluster = factor(cluster_label))
cat("Distribusi observasi per cluster:\n")
print(table(df_result$cluster))
# ── 10. Visualisasi PCA Biplot ─────────────────────────────────
# Reduksi dimensi ke 2 PC untuk melihat pemisahan cluster di ruang 2D
fviz_cluster(
list(data = df_scaled, cluster = cluster_label),
geom           = "point",
ellipse.type   = "convex",
palette        = "jco",
ggtheme        = theme_minimal(base_size = 12),
main           = paste0("Visualisasi Cluster PCA (k = ", k_optimal, ")\n",
"ISPU DKI Jakarta — Hierarchical Ward.D2")
) +
labs(subtitle = "Sumbu PC1 & PC2 merepresentasikan kombinasi linear variabel polutan") +
theme(plot.title    = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5, color = "gray50"))
ggsave("plot_3_pca_cluster.png", width = 9, height = 6, dpi = 150)
cat("[✓] Plot PCA Cluster disimpan: plot_3_pca_cluster.png\n")
# ── 11. Interpretasi: Profil Rata-rata Tiap Cluster ───────────
cat("\n", strrep("=", 55), "\n")
cat("PROFIL RATA-RATA TIAP CLUSTER (skala asli)\n")
cat(strrep("=", 55), "\n")
profil <- df_result %>%
group_by(cluster) %>%
summarise(
n        = n(),
pm10_avg = round(mean(pm10),  1),
so2_avg  = round(mean(so2),   1),
co_avg   = round(mean(co),    1),
o3_avg   = round(mean(o3),    1),
no2_avg  = round(mean(no2),   1),
.groups  = "drop"
)
print(profil)
# Komposisi stasiun per cluster
cat("\nKomposisi Stasiun per Cluster:\n")
df_result %>%
count(cluster, stasiun) %>%
arrange(cluster, desc(n)) %>%
print(n = 50)
# -----------------------------------------------------------------------------
# 1. LOAD LIBRARY
# -----------------------------------------------------------------------------
# Pastikan package berikut sudah terinstal. Jika belum, jalankan baris install
# yang dikomentari terlebih dahulu.
# install.packages(c("tidyverse", "cluster", "factoextra",
#                    "dendextend", "corrplot", "scales"))
suppressPackageStartupMessages({
library(tidyverse)    # Manipulasi & visualisasi data
library(cluster)      # Algoritma dan metrik clustering
library(factoextra)   # Ekstraksi dan visualisasi hasil clustering
library(dendextend)   # Kustomisasi dendrogram
library(corrplot)     # Visualisasi matriks korelasi
library(scales)       # Formatting skala plot
})
cat("======================================================\n")
cat("  HIERARCHICAL CLUSTERING - KUALITAS UDARA DKI JAKARTA\n")
cat("======================================================\n\n")
# Buat folder output jika belum ada
output_dir <- "output"
if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)
# Helper function untuk menyimpan plot dan menampilkannya di RStudio
save_plot <- function(plot_obj, filename, w = 1000, h = 600, r = 120) {
render <- function() if (inherits(plot_obj, "ggplot")) print(plot_obj) else plot_obj()
render()
png(file.path(output_dir, filename), width = w, height = h, res = r)
render()
invisible(dev.off())
cat(sprintf("[SAVED] %s\n", filename))
}
# -----------------------------------------------------------------------------
# 2. LOAD DATASET
# -----------------------------------------------------------------------------
# Membaca dataset CSV ke dalam dataframe R.
# Pastikan file 'ispu_dki_all.csv' berada di direktori kerja yang sama,
# atau ubah path di bawah sesuai lokasi file Anda.
file_path <- "d:/semester6/matkul machine learning/Hierarchical Clustering/ispu_dki_all.csv"
# Cek keberadaan file
if (!file.exists(file_path)) {
stop(paste("File tidak ditemukan:", file_path,
"\nSilakan sesuaikan variabel 'file_path' dengan lokasi file Anda."))
}
df_raw <- read.csv(file_path, stringsAsFactors = FALSE)
cat(">>> Dataset berhasil dimuat.\n")
cat(sprintf("    Jumlah baris : %d\n", nrow(df_raw)))
cat(sprintf("    Jumlah kolom : %d\n\n", ncol(df_raw)))
# Tampilkan preview awal
cat(">>> Preview 6 baris pertama:\n")
print(head(df_raw))
cat("\n>>> Struktur kolom:\n")
str(df_raw)
# -----------------------------------------------------------------------------
# 3. PREPROCESSING DATA
# -----------------------------------------------------------------------------
cat("\n--- MEMBERSIHKAN DATA ---\n")
colnames(df_raw) <- tolower(trimws(colnames(df_raw)))
df_raw$stasiun <- trimws(df_raw$stasiun)
polutan_cols <- c("pm10", "so2", "co", "o3", "no2")
df_raw[polutan_cols] <- lapply(df_raw[polutan_cols], function(x) suppressWarnings(as.numeric(x)))
df_clean <- df_raw[rowSums(!is.na(df_raw[polutan_cols])) > 0, ]
df_clean <- df_clean[!is.na(df_clean$stasiun) & nchar(df_clean$stasiun) > 0, ]
cat(sprintf("✅ Data siap diproses: %d baris & %d stasiun\n\n", nrow(df_clean), length(unique(df_clean$stasiun))))
# =============================================================================
# OUTPUT 1: Tabel Statistik Deskriptif
# =============================================================================
cat("Menghasilkan Output 1 (Statistik Deskriptif)...\n")
stats_list <- lapply(polutan_cols, function(col) {
x <- df_clean[[col]]
data.frame(
Polutan = toupper(col), Min = min(x, na.rm = T), Median = median(x, na.rm = T),
Mean = round(mean(x, na.rm = T), 2), Max = max(x, na.rm = T), SD = round(sd(x, na.rm = T), 2)
)
})
stats_df <- do.call(rbind, stats_list)
write.csv(stats_df, file.path(output_dir, "01_statistik_deskriptif.csv"), row.names = FALSE)
cat("[SAVED] 01_statistik_deskriptif.csv\n\n")
# =============================================================================
# OUTPUT 2 & 3: EDA (Heatmap Polutan & Matriks Korelasi)
# =============================================================================
cat("Menghasilkan Output 2 & 3 (Heatmap & Korelasi)...\n")
df_station <- df_clean %>%
group_by(stasiun) %>%
summarise(across(all_of(polutan_cols), \(x) round(mean(x, na.rm = TRUE), 2)), .groups = "drop")
df_station_long <- df_station %>%
pivot_longer(cols = all_of(polutan_cols), names_to = "polutan", values_to = "nilai") %>%
mutate(polutan = toupper(polutan))
p02 <- ggplot(df_station_long, aes(x = polutan, y = stasiun, fill = nilai)) +
geom_tile(color = "white", linewidth = 0.5) +
geom_text(aes(label = round(nilai, 1)), size = 4) +
scale_fill_gradientn(colors = c("#d1e8ff", "#5aafe8", "#003f7b"), name = "Indeks") +
labs(title = "Heatmap Rata-rata Polutan per Stasiun", x = "Polutan", y = "Stasiun") +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold", hjust = 0.5))
save_plot(p02, "02_heatmap_polutan_stasiun.png", 900, 500)
cor_matrix <- cor(df_clean[polutan_cols], use = "pairwise.complete.obs")
save_plot(function() {
corrplot(cor_matrix,
method = "color", type = "upper", tl.col = "black", tl.srt = 45,
addCoef.col = "black", title = "Matriks Korelasi Polutan", mar = c(0, 0, 2, 0)
)
}, "03_korelasi_polutan.png", 700, 600)
cat("\n")
# =============================================================================
# OUTPUT 4: Matriks Jarak Euclidean
# =============================================================================
cat("Menghasilkan Output 4 (Matriks Jarak)...\n")
feature_matrix <- as.matrix(df_station[polutan_cols])
rownames(feature_matrix) <- df_station$stasiun
feature_scaled <- scale(feature_matrix) # Z-score scaling
dist_matrix <- dist(feature_scaled, method = "euclidean")
dist_df <- data.frame(Stasiun = rownames(feature_scaled), as.data.frame(round(as.matrix(dist_matrix), 4)))
write.csv(dist_df, file.path(output_dir, "04_matriks_jarak.csv"), row.names = FALSE)
cat("[SAVED] 04_matriks_jarak.csv\n\n")
# =============================================================================
# OUTPUT 5: Perbandingan CCC (Cophenetic Score)
# =============================================================================
cat("Menghasilkan Output 5 (Evaluasi CCC)...\n")
linkage_methods <- c("complete", "average", "single", "ward.D2")
hc_list <- list()
for (method in linkage_methods) hc_list[[method]] <- hclust(dist_matrix, method = method)
ccc_scores <- sapply(linkage_methods, function(m) round(cor(dist_matrix, cophenetic(hc_list[[m]])), 4))
best_method <- linkage_methods[which.max(ccc_scores)]
hc_best <- hc_list[[best_method]]
write.csv(data.frame(Metode = toupper(linkage_methods), Skor_CCC = ccc_scores),
file.path(output_dir, "05_ccc_scores.csv"),
row.names = FALSE
)
cat("[SAVED] 05_ccc_scores.csv\n\n")
# =============================================================================
# OUTPUT 6: Analisis Silhouette (Menentukan Jumlah Cluster Optimal)
# =============================================================================
cat("Menghasilkan Output 6 (Silhouette Score)...\n")
k_values <- 2:(nrow(feature_scaled) - 1)
sil_scores <- sapply(k_values, function(k) mean(silhouette(cutree(hc_best, k), dist_matrix)[, 3]))
optimal_k <- k_values[which.max(sil_scores)]
sil_df <- data.frame(k = k_values, silhouette = round(sil_scores, 4))
p06 <- ggplot(sil_df, aes(x = k, y = silhouette)) +
geom_line(color = "#457B9D", linewidth = 1.2) +
geom_point(color = "#E63946", size = 4) +
geom_vline(xintercept = optimal_k, linetype = "dashed", color = "#333333") +
geom_label(aes(label = silhouette), nudge_y = 0.01) +
labs(title = "Evaluasi Jumlah Cluster Optimal (Silhouette)", x = "Jumlah Cluster (k)", y = "Score") +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold", hjust = 0.5))
save_plot(p06, "06_silhouette_score.png", 700, 500)
cat("\n")
# =============================================================================
# OUTPUT 7 & 8: Dendrogram Terbaik & PCA Biplot
# =============================================================================
cat("Menghasilkan Output 7 & 8 (Dendrogram & PCA)...\n")
cluster_labels_raw <- cutree(hc_best, k = optimal_k)
# Urutkan nama cluster berdasarkan rata-rata tingkat polusi
clust_means <- tapply(rowMeans(feature_scaled), cluster_labels_raw, mean)
ordered_clust <- order(clust_means)
semantic_names <- rep("", optimal_k)
if (optimal_k == 3) {
semantic_names[ordered_clust[1]] <- "Baik"
semantic_names[ordered_clust[2]] <- "Sedang"
semantic_names[ordered_clust[3]] <- "Tidak Sehat"
} else {
for (i in seq_len(optimal_k)) semantic_names[ordered_clust[i]] <- sprintf("Level %d", i)
}
cluster_labels <- semantic_names[cluster_labels_raw]
names(cluster_labels) <- names(cluster_labels_raw)
# Beri warna: Hijau (Baik), Kuning (Sedang), Merah (Tidak Sehat)
cluster_colors <- c("#2A9D8F", "#E9C46A", "#E63946", "#457B9D")[1:optimal_k]
names(cluster_colors) <- semantic_names[ordered_clust]
# 7. Dendrogram
dend_best <- as.dendrogram(hc_best) %>%
color_branches(k = optimal_k, col = cluster_colors) %>%
set("labels_cex", 1.0) %>%
set("branches_lwd", 2)
save_plot(function() {
par(mar = c(5, 5, 4, 2))
plot(dend_best,
main = sprintf("Dendrogram Hierarchical Clustering (Metode: %s)", toupper(best_method)),
ylab = "Jarak Euclidean", xlab = "Stasiun Pemantauan", cex.main = 1.2
)
abline(h = 1.5, col = "gray40", lty = 2, lwd = 1.5)
}, "07_dendrogram_terbaik.png", 900, 600)
# 8. PCA Biplot
pca_res <- as.data.frame(prcomp(feature_scaled)$x)
pca_res$stasiun <- rownames(pca_res)
pca_res$cluster <- cluster_labels
p08 <- ggplot(pca_res, aes(x = PC1, y = PC2, color = cluster, label = stasiun)) +
geom_point(size = 5) +
geom_text(vjust = -1, fontface = "bold") +
scale_color_manual(values = cluster_colors) +
labs(title = "PCA Biplot: Pemetaan Cluster Stasiun", x = "PC1", y = "PC2") +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold", hjust = 0.5))
save_plot(p08, "08_pca_biplot_cluster.png", 800, 600)
cat("\n")
# =============================================================================
# OUTPUT 9 & 10: Profiling Cluster & Kategori Barplot
# =============================================================================
cat("Menghasilkan Output 9 & 10 (Profil Barplot & Kategori)...\n")
# Gabungkan data cluster
df_clustered <- df_clean %>%
left_join(data.frame(stasiun = names(cluster_labels), Cluster = cluster_labels), by = "stasiun")
# 9. Barplot Rata-Rata Polutan
cluster_avg_long <- df_clustered %>%
filter(!is.na(Cluster)) %>%
group_by(Cluster) %>%
summarise(across(all_of(polutan_cols), \(x) mean(x, na.rm = T))) %>%
pivot_longer(-Cluster, names_to = "Polutan", values_to = "Nilai") %>%
mutate(Polutan = toupper(Polutan))
p09 <- ggplot(cluster_avg_long, aes(x = Polutan, y = Nilai, fill = Cluster)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7) +
geom_text(aes(label = round(Nilai, 1)), position = position_dodge(width = 0.8), vjust = -0.5, size = 3) +
scale_fill_manual(values = cluster_colors) +
labs(title = "Profil Rata-rata Polutan per Cluster", x = "Polutan", y = "Nilai") +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold", hjust = 0.5))
save_plot(p09, "09_barplot_profil_cluster.png", 900, 500)
# 10. Kategori Kualitas Udara
if ("categori" %in% colnames(df_clustered)) {
df_cat <- df_clustered %>%
filter(!is.na(Cluster), nchar(trimws(categori)) > 0) %>%
mutate(categori = toupper(trimws(categori))) %>%
count(Cluster, categori) %>%
group_by(Cluster) %>%
mutate(pct = round(n / sum(n) * 100, 1))
kat_colors <- c("BAIK" = "#2A9D8F", "SEDANG" = "#E9C46A", "TIDAK SEHAT" = "#F4A261", "SANGAT TIDAK SEHAT" = "#E76F51")
p10 <- ggplot(df_cat, aes(x = Cluster, y = pct, fill = categori)) +
geom_col(width = 0.7, position = "stack") +
geom_text(aes(label = paste0(pct, "%")), position = position_stack(vjust = 0.5), color = "white", fontface = "bold") +
scale_fill_manual(values = kat_colors, na.value = "gray70") +
labs(title = "Distribusi Kategori Kualitas Udara per Cluster", y = "Persentase", fill = "Kategori") +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold", hjust = 0.5))
save_plot(p10, "10_kategori_per_cluster.png", 900, 500)
}
# -----------------------------------------------------------------------------
cat("\n=============================================================\n")
cat("SELESAI! Seluruh 10 Output Wajib Berhasil Disimpan di folder ./output/\n")
if (interactive()) try(browseURL(normalizePath(output_dir)), silent = TRUE)
